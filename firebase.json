{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/functions/**",
      "**/.git/**",
      "**/.env*",
      "**/firebase-key.json",
      "**/server.js",
      "**/routes/**",
      "**/services/**",
      "**/middleware/**",
      "**/config/**",
      "**/api/**",
      "**/.dist/**",
      "**/package.json",
      "**/package-lock.json",
      "**/render.yaml",
      "**/vercel.json",
      "**/*.rules",
      "**/*.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
