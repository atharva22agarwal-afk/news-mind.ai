# =====================================================
# NewsMind AI - Environment Configuration
# Copy this file to .env and fill in your actual values
# =====================================================

# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=development

# ==================== FIREBASE CONFIGURATION ====================
# Path to your Firebase service account key (download from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json

# ==================== AI API KEYS ====================
# Google Gemini API (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: Cohere API (get from https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# ==================== EXTERNAL SERVICES ====================
# Serper.dev for Google Search (get from https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# Google Cloud Text-to-Speech (get from Google Cloud Console)
GOOGLE_CLOUD_API_KEY=

# ==================== SECURITY CONFIGURATION ====================
# Allowed CORS Origins (comma-separated list of frontend URLs)
# Add your production domain here
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5000,http://127.0.0.1:3002,http://127.0.0.1:5000

# Rate Limiting Configuration
# General API rate limit (requests per window)
GENERAL_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_WINDOW_MS=900000

# AI endpoints rate limit (AI is expensive!)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000

# Authentication rate limit (prevent brute force)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# File upload rate limit
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# Chat/Debate rate limit
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Request size limits (in bytes)
MAX_REQUEST_SIZE=10485760
MAX_FILE_SIZE=10485760

# ==================== OPTIONAL: DEPLOYMENT ====================
# Set to 'production' when deploying
# VERCEL=production

# ==================== FIREBASE CLIENT CONFIG ====================
# These are used in firebase-client.js for browser authentication
# Get these from Firebase Console > Project Settings > General > Your apps

# FIREBASE_CLIENT_API_KEY=your_client_api_key
# FIREBASE_CLIENT_AUTH_DOMAIN=your-app.firebaseapp.com
# FIREBASE_CLIENT_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_STORAGE_BUCKET=your-app.appspot.com
# FIREBASE_CLIENT_MESSAGING_SENDER_ID=123456789
# FIREBASE_CLIENT_APP_ID=1:123456789:web:abc123def456

# ==================== LOGGING & MONITORING ====================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed error messages (disable in production)
DEBUG_ERRORS=true

# ==================== CACHE CONFIGURATION ====================
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Cache cleanup interval in seconds
CACHE_CHECK_PERIOD=600

# ==================== CONTENT LIMITS ====================
# Maximum words to store per summary
MAX_WORD_COUNT=50000

# Maximum content length (characters)
MAX_CONTENT_LENGTH=500000

# ==================== DEVELOPMENT FLAGS ====================
# Set to 'true' to disable rate limiting (DEVELOPMENT ONLY!)
DISABLE_RATE_LIMIT=false

# Enable verbose AI logging
DEBUG_AI=false
