rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a participant in debate
    function isParticipant(resource) {
      return isAuthenticated() && request.auth.uid in resource.data.participants;
    }
    
    // ==================== SUMMARIES ====================
    match /summaries/{summaryId} {
      // Allow read if: document is public OR user owns it
      allow read: if resource.data.isPublic == true || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // Allow create if: authenticated and userId matches
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.title is string &&
                       request.resource.data.summary is string;
      
      // Allow update if: user owns the document
      allow update: if isOwner(resource.data.userId);
      
      // Allow delete if: user owns the document
      allow delete: if isOwner(resource.data.userId);
      
      // Validate data structure on create/update
      allow create, update: if 
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.summary is string &&
        request.resource.data.userId is string &&
        request.resource.data.createdAt is timestamp;
    }
    
    // ==================== DEBATES ====================
    match /debates/{debateId} {
      // Allow read if: user is a participant OR debate is public
      allow read: if resource.data.isPublic == true || 
                     (isAuthenticated() && request.auth.uid in resource.data.participants);
      
      // Allow create if: authenticated
      allow create: if isAuthenticated() &&
                       request.resource.data.topic is string &&
                       request.resource.data.participants is list &&
                       request.auth.uid in request.resource.data.participants;
      
      // Allow update if: user is a participant
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      // Allow delete if: user created the debate
      allow delete: if isAuthenticated() && 
                       resource.data.createdBy == request.auth.uid;
      
      // Validate data structure
      allow create, update: if
        request.resource.data.topic is string &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 10;
    }
    
    // ==================== POLLS ====================
    match /polls/{pollId} {
      // Allow read if: poll is active OR user owns it
      allow read: if resource.data.isActive == true || 
                     (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      
      // Allow create if: authenticated
      allow create: if isAuthenticated() &&
                       request.resource.data.question is string &&
                       request.resource.data.options is list &&
                       request.resource.data.options.size() >= 2 &&
                       request.resource.data.options.size() <= 6;
      
      // Allow update if: user owns the poll
      allow update: if isOwner(resource.data.createdBy);
      
      // Allow delete if: user owns the poll
      allow delete: if isOwner(resource.data.createdBy);
    }
    
    // ==================== PUBLIC POSTS ====================
    match /public_posts/{postId} {
      // Allow read for everyone
      allow read: if true;
      
      // Allow create if: authenticated
      allow create: if isAuthenticated() &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() <= 1000;
      
      // Allow update/delete if: user owns the post
      allow update, delete: if isAuthenticated() && 
                               resource.data.userId == request.auth.uid;
    }
    
    // ==================== USER PREFERENCES ====================
    match /userPreferences/{userId} {
      // Users can only read/write their own preferences
      allow read, write: if isAuthenticated() && 
                            request.auth.uid == userId;
    }
    
    // ==================== ANALYTICS (Read-only for admins) ====================
    match /analytics/{docId} {
      // Only allow read/write from admin functions
      allow read, write: if false;
    }
    
    // ==================== RATE LIMITING COLLECTION ====================
    match /rateLimits/{userId} {
      // Only server/admin can write
      allow read, write: if false;
    }
  }
}
